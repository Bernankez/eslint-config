{
  "name": "@bernankez/eslint-config",
  "type": "module",
  "version": "5.1.1",
  "packageManager": "pnpm@11.3.0",
  "description": "Cole's ESLint config",
  "author": {
    "name": "Cole",
    "email": "bernankeic@gmail.com",
    "url": "https://github.com/Bernankez"
  },
  "license": "MIT",
  "homepage": "https://github.com/Bernankez/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bernankez/eslint-config.git"
  },
  "bugs": "https://github.com/Bernankez/eslint-config/issues",
  "keywords": [
    "eslint-config"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.mts"
      ]
    }
  },
  "bin": "./bin/index.js",
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsdown --format esm,cjs",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "nr build && npx @eslint/config-inspector build",
    "fix": "eslint . -f mo --fix",
    "lint": "eslint . -f mo",
    "bump": "nlx taze major -w -r --force",
    "prepack": "nr build",
    "prepare": "simple-git-hooks",
    "preview": "node --watch bin/index.js",
    "release": "bumpp && pnpm publish",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:once": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antfu/eslint-config": "~9.0.0",
    "@unocss/eslint-plugin": "^66.7.0",
    "cac": "^7.0.0",
    "defu": "^6.1.7",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-format": "^2.0.1",
    "local-pkg": "^1.2.1"
  },
  "devDependencies": {
    "@antfu/ni": "^30.1.0",
    "@eslint-react/eslint-plugin": "^5.8.5",
    "@types/node": "^25.9.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.4.0",
    "eslint-formatter-mo": "^2.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-svelte": "^3.17.1",
    "execa": "^9.6.1",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.55.9",
    "svelte-eslint-parser": "^1.6.1",
    "tinyglobby": "^0.2.16",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue": "^3.5.34"
  },
  "resolutions": {
    "eslint": "^10.4.0"
  },
  "simple-git-hooks": {
    "pre-commit": "nlx nano-staged"
  },
  "publishConfig": {
    "access": "public"
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}
